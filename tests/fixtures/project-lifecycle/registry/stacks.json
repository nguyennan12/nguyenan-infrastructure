{
  "version": 1,
  "stacks": [
    {
      "id": "mock-stack",
      "enabled": true,
      "required": false,
      "compose_file": "stacks/mock-stack.yml",
      "project_name": "infra-mock-stack",
      "dependencies": [],
      "containers": ["infra-mock-service"],
      "volumes": [],
      "required_env": ["MOCK_TOKEN"],
      "secret_file": "mock.env",
      "handler": "generic",
      "readiness": "container-running",
      "supports_fresh_init": false,
      "supports_recovery": false,
      "secrets": [
        {"name": "MOCK_TOKEN", "generator": "password"}
      ]
    }
  ]
}
