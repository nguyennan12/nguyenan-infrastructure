{
  "version": 1,
  "services": [
    {
      "id": "postgres",
      "display_name": "PostgreSQL",
      "stack": "database",
      "enabled": true,
      "dependencies": [],
      "capabilities": ["project-provision", "health", "backup", "restore"],
      "module": "scripts/services/postgres/adapter.sh",
      "project_env": ["POSTGRES_HOST", "POSTGRES_PORT", "POSTGRES_DB", "POSTGRES_USER", "POSTGRES_PASSWORD", "DATABASE_URL"],
      "backup": {"script": "scripts/services/postgres/backup.sh", "tag": "postgresql", "order": 10, "required_when_enabled": true},
      "restore": {"script": "scripts/services/postgres/restore.sh", "phase": "after-database-start", "order": 30},
      "managed_files": [
        {"source": "scripts/services/postgres/provision.sh", "destination": "scripts/services/postgres/provision.sh"},
        {"source": "scripts/services/postgres/adapter.sh", "destination": "scripts/services/postgres/adapter.sh"},
        {"source": "scripts/services/postgres/backup.sh", "destination": "backup/backup-postgres.sh"},
        {"source": "scripts/services/postgres/restore.sh", "destination": "scripts/restore-postgres.sh"}
      ]
    },
    {
      "id": "redis",
      "display_name": "Redis",
      "stack": "cache",
      "enabled": true,
      "dependencies": [],
      "capabilities": ["project-provision", "health", "backup", "restore"],
      "module": "scripts/services/redis/adapter.sh",
      "project_env": ["REDIS_HOST", "REDIS_PORT", "REDIS_USER", "REDIS_PASSWORD", "REDIS_KEY_PREFIX", "REDIS_URL"],
      "backup": {"script": "scripts/services/redis/backup.sh", "tag": "redis", "order": 20, "required_when_enabled": true},
      "restore": {"script": "scripts/services/redis/restore.sh", "phase": "before-service-start", "order": 20},
      "managed_files": [
        {"source": "scripts/services/redis/provision.sh", "destination": "scripts/services/redis/provision.sh"},
        {"source": "scripts/services/redis/adapter.sh", "destination": "scripts/services/redis/adapter.sh"},
        {"source": "scripts/services/redis/backup.sh", "destination": "backup/backup-redis.sh"},
        {"source": "scripts/services/redis/restore.sh", "destination": "scripts/restore-redis.sh"}
      ]
    },
    {
      "id": "minio",
      "display_name": "MinIO",
      "stack": "storage",
      "enabled": true,
      "dependencies": [],
      "capabilities": ["project-provision", "health", "backup", "restore"],
      "module": "scripts/services/minio/adapter.sh",
      "project_env": ["S3_ENDPOINT", "S3_BUCKET", "S3_ACCESS_KEY", "S3_SECRET_KEY", "S3_REGION", "S3_FORCE_PATH_STYLE"],
      "backup": {"script": "scripts/services/minio/backup.sh", "tag": "minio", "order": 30, "required_when_enabled": true},
      "restore": {"script": "scripts/services/minio/restore.sh", "phase": "after-service-start", "order": 40},
      "managed_files": [
        {"source": "scripts/services/minio/provision.sh", "destination": "scripts/services/minio/provision.sh"},
        {"source": "scripts/services/minio/adapter.sh", "destination": "scripts/services/minio/adapter.sh"},
        {"source": "scripts/services/minio/backup.sh", "destination": "backup/backup-minio.sh"},
        {"source": "scripts/services/minio/restore.sh", "destination": "scripts/restore-minio.sh"}
      ]
    }
  ]
}
